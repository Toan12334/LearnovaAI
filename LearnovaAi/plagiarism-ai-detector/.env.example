# ============================================================
# Environment Variables Configuration
# ============================================================

# App Config
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=True

# Database - PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=plagiarism_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/plagiarism_db

# Vector DB - Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Cache - Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Search APIs (Google / Bing / Serper)
SEARCH_API_KEY=your_search_api_key_here
SEARCH_ENGINE_ID=your_search_engine_id_here

# LLM / AI Detection Models
HUGGINGFACE_API_KEY=
