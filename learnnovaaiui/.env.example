# LearnovaAI Frontend Environment Variables Example
# Khi chạy local dev: trỏ về FastAPI Backend (mặc định cổng 8000)
# VITE_API_URL=http://localhost:8000
#
# Khi deploy production: trỏ về Railway / Cloud Server
# VITE_API_URL=https://learnovaai-production-8fe5.up.railway.app
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=LearnovaAI
VITE_APP_VERSION=1.0.0
